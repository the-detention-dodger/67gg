<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" type="image/webp" href="/imgs/Minecraft_Earth_Grass_Block.webp">
<title>Tom's Chill Space</title>
<style is:global>
@font-face {
  font-family: 'Minecraft';
  src: url('/fonts/Minecraft-Regular.woff2') format('woff2');
  font-weight: 400;
  font-display: swap;
}
@font-face {
  font-family: 'Minecraft';
  src: url('/fonts/Minecraft-Bold.woff2') format('woff2');
  font-weight: 700;
  font-display: swap;
}
@font-face {
  font-family: 'Minecrafter Alt';
  src: url('/fonts/MinecrafterAlt.woff2') format('woff2');
  font-display: swap;
}

:root {
  --block-size: 48px;
  --panel-zoom: 10;
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; min-height: 100%; }

body {
  font-family: 'Minecraft', system-ui, sans-serif;
  color: #fff;
  background-color: #6b6b6b;
  background-image: url('/imgs/wool-green.png');
  background-size: var(--block-size) var(--block-size);
  background-repeat: repeat;
  image-rendering: pixelated;
  overflow-x: hidden;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 0;
  pointer-events: none;
}

#floaters {
  position: fixed;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  overflow: hidden;
}

.floater {
  position: absolute;
  will-change: transform;
}

/* 16x16 Minecraft sprites: keep hard pixel edges */
.floater.sprite {
  width: 64px;
  height: 64px;
  image-rendering: pixelated;
  filter: drop-shadow(3px 3px 0 rgba(0, 0, 0, 0.5));
}

/* Photos: smooth scaling, full image visible, rounded frame */
.floater.photo {
  width: 96px;
  height: 96px;
  object-fit: contain;
  image-rendering: auto;
  border-radius: 6px;
  filter: drop-shadow(2px 2px 4px rgba(0, 0, 0, 0.6));
}

.page {
  position: relative;
  z-index: 2;
  max-width: 46rem;
  margin: 0 auto;
  padding: 2rem 1.25rem 3rem;
  text-align: center;
}

h1 {
  font-family: 'Minecrafter Alt', 'Minecraft', sans-serif;
  font-size: clamp(2rem, 7vw, 4rem);
  line-height: 1.2;
  margin: 0 0 0.5rem;
  color: #fdf6b2;
  text-shadow: 4px 4px #000;
  letter-spacing: 0.03em;
}

h1 sup {
  font-size: 0.5em;
  vertical-align: super;
  line-height: 0;
}

.subtitle {
  font-size: clamp(1rem, 2.5vw, 1.4rem);
  color: #a7f3d0;
  text-shadow: 2px 2px #000;
  margin: 0 0 1.75rem;
}

.panel {
  border-style: solid;
  border-width: calc(var(--block-size) / var(--panel-zoom));
  border-image: url('/imgs/panel.png');
  border-image-width: calc(var(--block-size) / var(--panel-zoom));
  border-image-slice: 43% 43% fill;
  border-image-repeat: stretch;
  image-rendering: pixelated;
  padding: 1rem;
  margin: 0 auto 1.5rem;
  max-width: 22rem;
}

.panel.wide {
  max-width: 30rem;
  border-image-slice: 43% 43%;
  background-color: #61371F;
  background-clip: padding-box;
}

.photo-slot {
  border-style: solid;
  border-width: calc(var(--block-size) / 12);
  border-image: url('/imgs/slot.png');
  border-image-width: calc(var(--block-size) / 12);
  border-image-slice: 43% 43% fill;
  border-image-repeat: stretch;
  image-rendering: pixelated;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.photo-slot img {
  width: 100%;
  height: auto;
  max-height: 70vh;
  object-fit: contain;
  display: block;
}

.photo-empty {
  font-size: 0.95rem;
  color: #d1d5db;
  text-shadow: 2px 2px #000;
  padding: 1rem;
  line-height: 1.7;
}

.message {
  font-size: clamp(0.95rem, 2vw, 1.15rem);
  line-height: 1.9;
  text-shadow: 2px 2px #000;
  margin: 0;
}

.button {
  display: inline-block;
  font-family: 'Minecraft', sans-serif;
  font-size: 1.1rem;
  padding: 0.75rem 2rem;
  cursor: pointer;
  user-select: none;
  image-rendering: pixelated;
  background-size: cover;
  background-image: url('/imgs/button-inside.png');
  border-style: solid;
  border-width: calc(var(--block-size) / var(--panel-zoom));
  border-image: url('/imgs/button-border.png');
  border-image-width: calc(var(--block-size) / var(--panel-zoom));
  border-image-slice: 10% 3%;
  border-image-repeat: stretch;
  color: #d1d5db;
  text-shadow: 2px 2px #000;
  text-decoration: none;
}

.button:hover {
  background-image: url('/imgs/button-inside-hover.png');
  border-image: url('/imgs/button-border-hover.png');
  color: #fef08a;
}

@media (prefers-reduced-motion: reduce) {
  .floater { display: none; }
}
</style>
</head>
<body>

<div id="floaters" aria-hidden="true"></div>

<main class="page">
  <h1>Happy [6+7]<sup>th</sup> Birthday, Tom!</h1>
  <p class="subtitle">Achievement Unlocked: Teenager Mode Loading...</p>

  <div class="panel">
    <div class="photo-slot">
      <img src="/imgs/breathe_fire.png" alt="Tom breathing fire">
    </div>
  </div>

  <div class="panel wide">
    <p class="message">
      Enjoy your absolutely best time ever!<br>
      And if it gets spicy sometimes<br>
      You know what? Doesn't matter.
    </p>
  </div>

  <a class="button" href="#" id="burst">Spawn Fireworks</a>
</main>

<script is:inline>
const ITEMS = [
  'emerald', 'nether-star', 'record-cat', 'gold-ingot',
  'bee_types.webp', 'creeper_je2_be1.webp', 'chicken_jockey.webp', 'cow_je5_be2.webp',
  'Alex_in_elytra.webp', 'Baby_Cow_JE2_BE2.webp', 'Baby_Tuxedo_Cat.webp',
  'Dirt.webp', 'Enderman_Screaming.webp', 'Lava_JE14.webp', 'Lucy_Axolotl_JE2.webp',
  'Minecraft_Earth_Grass_Block.webp', 'Steve_in_elytra.webp',
  'TNT_JE3_BE2.webp', 'Wolf_JE2_BE2.webp', 'Zombie_JE3_BE2.webp',
  'Bow_29_JE1_BE1.webp', 'Crafting_Table_JE4_BE3.webp', 'Diamond_JE3_BE3.webp',
  'Diamond_Pickaxe_JE3_BE3.webp', 'Diamond_Sword_JE3_BE3.webp',
  'Polar_Bear.webp', 'Totem_of_Undying_JE2_BE2.webp', 'Pig_JE3_BE2.webp',
  'blaze.webp', 'goat_je1_be1.webp', 'chestnut_horse.webp', 'Oak_JE14.webp'
];

const layer = document.getElementById('floaters');
const sprites = [];

function makeFloater(name, x, y) {
  const el = document.createElement('img');
  el.className = 'floater ' + (/\.(webp|jpe?g|gif|avif)$/i.test(name) ? 'photo' : 'sprite');
  el.src = '/imgs/' + (name.includes('.') ? name : name + '.png');
  el.alt = '';
  layer.appendChild(el);

  const s = {
    el,
    x: x !== undefined ? x : Math.random() * (window.innerWidth - 64),
    y: y !== undefined ? y : Math.random() * (window.innerHeight - 64),
    vx: (Math.random() - 0.5) * 2.2,
    vy: (Math.random() - 0.5) * 2.2,
    rot: Math.random() * 360,
    vr: (Math.random() - 0.5) * 1.5
  };
  sprites.push(s);
  return s;
}

ITEMS.forEach((name) => makeFloater(name));

function tick() {
  for (const s of sprites) {
    const w = window.innerWidth - s.el.offsetWidth;
    const h = window.innerHeight - s.el.offsetHeight;

    s.x += s.vx;
    s.y += s.vy;
    s.rot += s.vr;

    if (s.x <= 0) { s.x = 0; s.vx = Math.abs(s.vx); }
    if (s.x >= w) { s.x = w; s.vx = -Math.abs(s.vx); }
    if (s.y <= 0) { s.y = 0; s.vy = Math.abs(s.vy); }
    if (s.y >= h) { s.y = h; s.vy = -Math.abs(s.vy); }

    s.el.style.transform =
      'translate(' + s.x + 'px,' + s.y + 'px) rotate(' + s.rot + 'deg)';
  }
  requestAnimationFrame(tick);
}
requestAnimationFrame(tick);

const MAX_SPRITES = 60;

document.getElementById('burst').addEventListener('click', (e) => {
  e.preventDefault();
  const r = e.currentTarget.getBoundingClientRect();
  const cx = r.left + r.width / 2 - 32;
  const cy = r.top + r.height / 2 - 32;
  for (let i = 0; i < 8; i++) {
    const s = makeFloater('fireworks', cx, cy);
    // Random direction and speed so each burst scatters differently
    const a = Math.random() * Math.PI * 2;
    const speed = 2 + Math.random() * 4;
    s.vx = Math.cos(a) * speed;
    s.vy = Math.sin(a) * speed;
    s.vr = (Math.random() - 0.5) * 6;
  }
  while (sprites.length > MAX_SPRITES) {
    sprites.shift().el.remove();
  }
});
</script>

</body>
</html>
